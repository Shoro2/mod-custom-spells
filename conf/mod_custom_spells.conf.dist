[worldserver]

########################################
# mod-custom-spells configuration
########################################
#
#    CustomSpells.Enable
#        Description: Enable custom spell effects module
#        Default:     1 - Enabled
#                     0 - Disabled
#

CustomSpells.Enable = 1

#
#    CustomSpells.BuffReplaceConfirm.Enable
#        Description: A player's cast of his own buff (an exclusive-highest group: Thorns, marks, blessings, ...)
#                     that would come out weaker than the one already on the target asks first in a popup
#                     (Yes casts it again and replaces the old buff). Off: such a cast always replaces.
#        Default:     1 - Ask
#                     0 - Always replace
#

CustomSpells.BuffReplaceConfirm.Enable = 1
