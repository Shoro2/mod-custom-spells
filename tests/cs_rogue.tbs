expect ro spell 900604 casts >= 2
expect ro spell 900604 casts <= 16
expect ro spell 900604 targets >= 5
expect ro spell 900604 damage >= 666
as gm .unlearn 900603

# ---------------------------------------------------------------- Combat + Subtlety strikes
log Combat - 900633 Sinister Strike +50 %
do ro learn 900633
expect ro spellmod 48638 damage 100 == 150
as gm .unlearn 900633

log Combat - 900634 Sinister Strike +9 targets: 10 in all (a cleave in front of you)
do ro learn 900634
expect ro spellmod 48638 jumptargets 0 == 10
spelllog start
do ro cast 48638 on d1 triggered
wait 1500ms
spelllog stop
expect ro spell 48638 maxtargets >= 6
as gm .unlearn 900634

log Subtlety - 900667 Hemorrhage +50 %
do ro learn 900667
expect ro spellmod 48660 damage 100 == 150
as gm .unlearn 900667

log Subtlety - 900668 Hemorrhage +9 targets: 10 in all (a cleave in front of you)
do ro learn 900668
expect ro spellmod 48660 jumptargets 0 == 10
spelllog start
do ro cast 48660 on d1 triggered
wait 1500ms
spelllog stop
expect ro spell 48660 maxtargets >= 6
as gm .unlearn 900668

# ---------------------------------------------------------------- Blade Flurry
log Combat - 900635 Blade Flurry lasts 2 min (15 sec + 105 sec)
do ro learn 900635
expect ro spellmod 13877 duration 15000 == 120000
do ro cast 13877 triggered
wait 500ms
expect ro aura 13877
expect ro auramaxduration 13877 >= 120000

log Combat - 900636 Blade Flurry hits +9 targets: with Blade Flurry up, 3 s of melee reach every other dummy (lines of its extra hit 22482), from the ring's middle
do ro learn 900636
do ro goto -270 150 -423.2
wait 500ms
do ro approach d1 3
wait 500ms
spelllog start
do ro attack d1
wait 3s
do ro stop
spelllog stop
expect ro spell 22482 targets >= 6
as gm .unlearn 900635
as gm .unlearn 900636
as gm .unaura 13877

cleanup
do ro stop
do gm target ro
as gm .unaura 13877
do ro destroy 2139
as gm .unlearn 900600
as gm .unlearn 900601
as gm .unlearn 900602
