# mod-custom-spells: the Warlock lines of the third concept list
# (operator 2026-10-31; share-public
# custom-spells/records/2026-10-31-third-concept-list.md), wave 1 = the
# spell modifiers and Shadow Cleave, wave 2 (the end of the file) = procs and
# stacking buffs, wave 3 = Drain Life +9 targets (900811) and Shadow Immolate
# (900883 / 900884), which also changes the Incinerate check of 900881: only a
# real Shadow Immolate counts now. Every check states the list's line, so a
# FAIL marks a defect.
# Test ground: map 13, the FL dummy arena - eight AoE Training Dummies
# (920018) on a 4-yd circle around (-270, 150); d1 = the west-most one. The
# warlock stands west of the ring facing it.
# Spells: Curse of Agony 47864, Drain Life 47857, Soul Fire 47825, Immolate
# 47811, Metamorphosis 47241 (talent) and its Shadow Cleave 50581 (no family
# flags: the two Shadow Cleave passives are C++). Wave 3: Shadow Bolt 47809,
# Incinerate 47838, Conflagrate 17962 (it needs the aura state AURA_STATE_
# CONFLAGRATE on the target and consumes Immolate or Shadow Immolate). A bot
# without gear has no spell power: Immolate rank 11 ticks 157 every 3 s, so
# Shadow Immolate ticks 314. Shadow Bolt can miss (a dummy is a level-83 target),
# so the transformation is tried with up to four bolts (P(all miss) < 0.1 %).
name    Custom spells - Warlock third list
timeout 360s

bot wl warlock slot=4

place 13 -279 150 -423.2 0
require wl alive
pick d1 creature:920018 near wl
require d1 exists
do gm target wl
as gm .unlearn 900807
as gm .unlearn 900808
as gm .unlearn 900853
as gm .unlearn 900854
as gm .unlearn 900878
as gm .unlearn 900879
as gm .unlearn 900880
as gm .unlearn 900809
as gm .unlearn 900855
as gm .unlearn 900857
as gm .unlearn 900881
as gm .unlearn 900811
as gm .unlearn 900883
as gm .unaura 900810
as gm .unaura 900882
as gm .unaura 47241
do wl learn 47864
do wl learn 47857
do wl learn 47825
do wl learn 47811
do wl learn 47241
as gm .aura 59756
waitfor wl aura 59756 timeout 2s

log Control - without the passives nothing is modified
expect wl spellmod 47864 dot 100 == 100
expect wl spellmod 47811 jumptargets 0 == 0

# ---------------------------------------------------------------- Affliction
log Affliction - 900807 "curse of agony +50% dmg" (its ticks), 900808 "drain life +50% damage" (its ticks)
do wl learn 900807
do wl learn 900808
expect wl spellmod 47864 dot 100 == 150
expect wl spellmod 47857 dot 100 == 150

# ---------------------------------------------------------------- Destruction
log Destruction - 900878 "soulfire +50% dmg", 900879 "soulfire +9 targets" (= 10)
do wl learn 900878
do wl learn 900879
expect wl spellmod 47825 damage 100 == 150
expect wl spellmod 47825 jumptargets 0 == 10
spelllog start
do wl cast 47825 on d1 triggered
wait 2500ms
spelllog stop
expect wl spell 47825 maxtargets >= 6

log Destruction - 900880 "immolate +9 targets" (= 10): the hit and the burn land on every chain target
do wl learn 900880
expect wl spellmod 47811 jumptargets 0 == 10
spelllog start
do wl cast 47811 on d1 triggered
wait 2500ms
spelllog stop
expect wl spell 47811 maxtargets >= 6
expect d1 aura 47811

# ---------------------------------------------------------------- Demonology
log Demonology - Shadow Cleave control: in Metamorphosis it hits 3 enemies (its own chain)
do wl approach d1
do wl cast 47241 triggered
wait 500ms
spelllog start
do wl cast 50581 on d1 triggered
wait 1s
spelllog stop
expect wl spell 50581 targets <= 3

log Demonology - 900853 "shadow cleave unlimited targets": every enemy in front within 8 yd
do wl learn 900853
do wl learn 900854
do wl reset
wait 300ms
spelllog start
do wl cast 50581 on d1 triggered
wait 1s
spelllog stop
expect wl spell 50581 targets >= 5

# ================================================================ wave 2
# Procs and stacking buffs (agent C, 2026-10-31). Spells: Life Tap rank 8
# 57946 (health -> mana; triggered casts count too), Corruption 47813,
# Incinerate rank 4 47838, Immolate 47811, Soul Fire 47825, Summon Felhunter
# 691 (NPC 417), Demon Charge 54785 (Metamorphosis; its stock stun 60995,
# cooldown 45 s), Full Heal 25840, Diseased Young Wolf 299 (level 1, to kill).
# The dummies take 0 damage and never die; a kill needs the wolf.

# ---------------------------------------------------------------- Affliction
log Affliction - 900809 CONCEPT "casting lifetap also increases the damage of your next dot by 10%, stacks 5 times. last 30sec": control, then three Life Taps (triggered: the passive hooks the cast, not a proc) = 3 stacks of Dark Tithe (900810), and the DoT modifier reads +30 %
do wl learn 57946
do wl learn 47813
do gm target wl
as gm .unaura 900810
do wl reset
expect wl spellmod 47813 dot 100 == 100
do wl learn 900809
do wl cast 57946 triggered
do wl cast 57946 triggered
do wl cast 57946 triggered
wait 500ms
expect wl aurastacks 900810 == 3
expect wl spellmod 47813 dot 100 == 130
# percent modifiers multiply: Curse of Agony +50 % (900807) x 3 stacks +30 % = 1.5 x 1.3
expect wl spellmod 47864 dot 100 == 195
expect wl spellmod 47811 dot 100 == 130
expect wl auramaxduration 900810 == 30000

log Affliction - 900809 the stacks stop at 5 (heal the warlock first: a Life Tap costs health)
do gm cast 25840 on wl triggered
wait 500ms
do wl cast 57946 triggered
do wl cast 57946 triggered
do wl cast 57946 triggered
wait 500ms
expect wl aurastacks 900810 == 5
expect wl spellmod 47813 dot 100 == 150

log Affliction - 900809 the NEXT dot cast uses every stack up (a normal cast of Corruption), the DoT is on the dummy
do gm cast 25840 on wl triggered
wait 1700ms
do wl cast 47813 on d1
wait 1s
expect wl noaura 900810
expect d1 aura 47813
expect wl spellmod 47813 dot 100 == 100

# ---------------------------------------------------------------- Demonology
log Demonology - 900855 CONCEPT "felhunter: aura that increases cast time of enemies by 25% in 40y range": control - a Felhunter without the passive puts nothing on the ring
do wl goto -279 150 -423.2
wait 500ms
do wl reset
do wl learn 691
do wl cast 691 triggered
wait 1s
pick fh creature:417 near wl
require fh exists
wait 2s
expect d1 noaura 900856

log Demonology - 900855 with the passive the Felhunter carries Spell Shackles (900856, an area aura of 40 yd: the dummies, 5-13 yd away, carry it, cast times x1.25 through the cast-speed field)
do wl learn 900855
# the area aura is owned by the Felhunter and applied to the enemies only: the
# Felhunter itself reports nothing, the dummies do
waitfor d1 aura 900856 timeout 4s
expect d1 aura 900856

log Demonology - 900855 the passive gone, the aura goes with it
as gm .unlearn 900855
waitfor d1 noaura 900856 timeout 3s
expect d1 noaura 900856
do wl cast 2641 triggered
wait 500ms

log Demonology - 900857 CONCEPT "demon charge now stun all enemies within 10y of the target and deal fire damage based on paragon level. if it kills an enemie, colldown is reset": control - without the passive Demon Charge (stock) neither burns nor stuns the ring and goes on its 45-s cooldown
do wl goto -279 150 -423.2
wait 500ms
do wl reset
do wl learn 47241
do wl cast 47241 triggered
wait 500ms
# Demon Charge has a minimum range (result 128 TOO_CLOSE): 16 yd from d1
do wl goto -290 150 -423.2
wait 500ms
spelllog start
do wl cast 54785 on d1
wait 1500ms
spelllog stop
expect wl spell 900860 casts == 0
expect wl spell 900859 casts == 0
expect wl cooldown 54785 > 30000

log Demonology - 900857 with the passive every enemy within 10 yd of d1 takes the Paragon Fire damage (8 dummies: 8 hits of 666 + 5 x Paragon level, 5,328-6,400 with crits) and the 7 others are stunned; no kill, so the cooldown holds
do wl learn 900857
do wl reset
do wl cast 47241 triggered
do wl goto -290 150 -423.2
wait 500ms
spelllog start
do wl cast 54785 on d1
wait 1500ms
spelllog stop
expect wl spell 900860 casts == 8
expect wl spell 900860 hits >= 6
expect wl spell 900860 damage >= 3996
expect wl spell 900860 damage <= 7200
expect wl spell 900859 casts == 7
expect wl cooldown 54785 > 30000

log Demonology - 900857 a kill resets Demon Charge: a Diseased Young Wolf (level 1) 5 yd from d1 dies of the shockwave and the cooldown is gone
do wl reset
do gm goto -272 152 -423.2
wait 300ms
as gm .npc add temp 299
wait 500ms
pick wolf creature:299 near d1 alive
require wolf exists
do wl cast 47241 triggered
do wl goto -290 150 -423.2
wait 500ms
do wl cast 54785 on d1
wait 1500ms
waitfor wolf missing timeout 3s
expect wl cooldown 54785 == 0
do gm goto -279 150 -423.2

# ---------------------------------------------------------------- Destruction
log Affliction - control for 900811: a Drain Life channel on d1 (6 s, the real ticks log as hits) drains d1 and heals the warlock - two units at most
do wl goto -279 150 -423.2
wait 500ms
do wl approach d1
do wl reset
spelllog start
do wl cast 47857 on d1
wait 6s
spelllog stop
do wl stop
expect wl spell 47857 targets <= 2
expect wl spell 47857 hits <= 12

log Affliction - 900811 "drain life +9 targets": with the passive every tick of the channel also drains the other seven dummies of the ring (up to 9 within 15 yd of d1): 8 dummies and the warlock are hit and healed over the channel, 8 hits a tick over 5 ticks
do wl learn 900811
do wl reset
wait 1700ms
spelllog start
do wl cast 47857 on d1
wait 6s
spelllog stop
do wl stop
expect wl spell 47857 targets >= 8
expect wl spell 47857 hits >= 30

log Affliction - 900811 breaking the channel ends the extra drains: a channel stopped after 2 s, then 3 s later no new hit
do wl reset
wait 1700ms
do wl cast 47857 on d1
wait 2s
do wl stop
wait 300ms
spelllog start
wait 3s
spelllog stop
expect wl spell 47857 hits == 0
as gm .unlearn 900811

# ---------------------------------------------------------------- Destruction
log Destruction - 900881 CONCEPT "if you hit a target affected by shadow immolate with your incenerate, your next soulfire does +50% damage, stacks 10 times": control - Incinerate on a dummy without Immolate gives no stack
do wl learn 47838
do wl learn 47811
do wl learn 47825
do wl learn 47809
do wl learn 17962
do wl learn 900881
do wl goto -279 150 -423.2
wait 500ms
do wl approach d1
do gm target wl
as gm .unaura 900882
do gm target d1
as gm .unaura 47811
as gm .unaura 900884
wait 300ms
do wl reset
do wl cast 47838 on d1 triggered
wait 1500ms
expect wl noaura 900882

log Destruction - 900881 control: a plain Immolate on the dummy is no Shadow Immolate (900883 not learned yet) - Incinerate gives no stack
do wl cast 47811 on d1 triggered
wait 800ms
expect d1 aura 47811
do wl cast 47838 on d1 triggered
wait 1500ms
expect wl noaura 900882

log Destruction - 900883 control: without the passive a Shadow Bolt leaves Immolate as it is
do wl cast 47809 on d1 triggered
wait 1200ms
expect d1 aura 47811
expect d1 noaura 900884

log Destruction - 900883 "when hit by shadow bolt the dot transforms in shadow immolate": with the passive a Shadow Bolt that hits (up to four tries, a miss is legal) turns Immolate into Shadow Immolate (900884): Immolate gone, and the time that was left kept (the Immolate was cast about 8 s earlier: between 3 and 11 s of its 15 left, not a fresh 15)
do wl learn 900883
do wl cast 47809 on d1 triggered
wait 1200ms
do wl cast 47809 on d1 triggered
wait 1200ms
do wl cast 47809 on d1 triggered
wait 1200ms
do wl cast 47809 on d1 triggered
wait 1200ms
expect d1 aura 900884
expect d1 noaura 47811
expect d1 auramaxduration 900884 <= 15000
expect d1 auraduration 900884 > 3000
expect d1 auraduration 900884 < 11000

log Destruction - 900881 with Shadow Immolate on the dummy every Incinerate hit adds a stack of Stoked Flames (900882, +50 % Soul Fire damage each): two hits = 2 stacks, the Soul Fire modifier reads 100 + 50 (900878, learned above) + 2 x 50
do wl cast 47838 on d1 triggered
wait 1500ms
do wl cast 47838 on d1 triggered
wait 1500ms
expect wl aurastacks 900882 == 2
# multiplying: Soul Fire +50 % (900878, learned above) x 2 stacks +100 % = 1.5 x 2.0
expect wl spellmod 47825 damage 100 == 300

log Destruction - 900881 the next Soul Fire uses every stack up
do wl cast 47825 on d1 triggered
wait 700ms
expect wl noaura 900882
expect wl spellmod 47825 damage 100 == 150

log Destruction - 900883 a new Immolate on the dummy replaces Shadow Immolate (two DoTs of the family would tick side by side): Immolate back, Shadow Immolate gone
do wl cast 47811 on d1 triggered
wait 800ms
expect d1 aura 47811
expect d1 noaura 900884

log Destruction - 900883 "double damage, shadowfire damage": Immolate turned into Shadow Immolate again (up to four bolts), then 6.4 s of ticks (every 3 s: 2 or 3 of them) - a bot without spell power: 314 a tick where Immolate does 157, so 500 or more in all (an undoubled DoT: 314 to 471)
do wl cast 47809 on d1 triggered
wait 1200ms
do wl cast 47809 on d1 triggered
wait 1200ms
do wl cast 47809 on d1 triggered
wait 1200ms
do wl cast 47809 on d1 triggered
wait 1200ms
expect d1 aura 900884
spelllog start
wait 6400ms
spelllog stop
expect wl spell 900884 ticks >= 2
expect wl spell 900884 damage >= 500

log Destruction - 900883 "the dot transforms ... the replacement must keep Immolate's aura state": Conflagrate (it needs AURA_STATE_CONFLAGRATE on the target and consumes Immolate or Shadow Immolate) works on the Shadow Immolate and eats it
do wl reset
spelllog start
do wl cast 17962 on d1 triggered
wait 800ms
spelllog stop
expect wl spell 17962 casts >= 1
expect d1 noaura 900884

cleanup
do wl stop
do gm target wl
as gm .unaura 47241
as gm .unaura 59756
as gm .unlearn 900807
as gm .unlearn 900808
as gm .unlearn 900853
as gm .unlearn 900854
as gm .unlearn 900878
as gm .unlearn 900879
as gm .unlearn 900880
as gm .unlearn 900809
as gm .unlearn 900855
as gm .unlearn 900857
as gm .unlearn 900881
as gm .unlearn 900811
as gm .unlearn 900883
as gm .unaura 900810
as gm .unaura 900882
do gm target d1
as gm .unaura 900884
as gm .unaura 47811
do gm target wl
