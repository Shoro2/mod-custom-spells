# mod-custom-spells: the second pet of the concept revision of 2026-10-08
# (share-public custom-spells/09-concept-revision-20261008.md, the operator's
# choice "B"): Hunter BM 900525 "you can now have 2 pets active" and Warlock
# Demonology 900858 "you can now have 2 demons active". The second pet is a
# guardian copy (marker aura 900526; the hunter's is creature 900525, the
# warlock's the stock entry of the demon that was out) with an AIO control bar
# of its own. The bar's bridge is the player command .cspet - the bots run it
# with "as"; the AIO frame itself needs a real client. Every check states the
# concept's behaviour, so a FAIL marks a defect.
# Test ground: map 13, the FL dummy arena - eight AoE Training Dummies (920018:
# take 0 damage, never die, the combat log still reads the full amount) on a
# 4-yd circle around (-270, 150); the hunter stands 15 yd west of the west-most
# one, d1, the warlock 6 yd north of the hunter.
# Bots: the slot-4 hunter with its Snow Tracker Wolf (1138; tame makes one when
# it has none) - on its bar Growl 61676, Furious Howl 64495, Bite 52474 and
# Cower 1742, autocast off - and a warlock on slot 5: one scenario cannot log
# slot 4 in twice (slot 5 otherwise holds Chronicle's warriors). The deaths,
# the dismiss and the relog run before any fight: a second pet that died comes
# back 10 sec after its owner left combat, and a training dummy's combat can
# outlast the test. The hunter's pet is out again at the end: cs_hunter expects
# it at login (a dismissed pet is not loaded at login, and tame does nothing
# while the bot has one).
# Spells: Call Pet 883, Revive Pet 982, Dismiss Pet 2641, Summon Imp 688 (NPC
# 416, Firebolt 47964), Summon Voidwalker 697 (1860), Summon Succubus 712 (1863);
# minion auras 901109 (+50 % damage, 900502 / 900836) and 901110 (+50 % melee
# haste, 900503).
name    Custom spells - Second pet (Hunter 900525, Warlock 900858)
timeout 420s

bot hu hunter slot=4
bot wl warlock slot=5

place 13 -279 150 -423.2 0
require hu alive
require wl alive
pick d1 creature:920018 near hu
require d1 exists
do gm target hu
as gm .unlearn 900525
as gm .unlearn 900502
as gm .unlearn 900503
as gm .unlearn 900504
do gm target wl
as gm .unlearn 900858
as gm .unlearn 900836
do hu learn 883
do hu learn 982
do hu learn 2641
do hu tame 1138
waitfor hu pet timeout 5s
do wl learn 688
do wl learn 697
do wl learn 712
do wl learn 2641
do hu goto -288.9 150 -423.2
do wl goto -288.9 156 -423.2
wait 1s
pick pt creature:1138 near hu
require pt exists

# ---------------------------------------------------------------- Hunter
log Hunter - control: without 900525 the hunter has its pet and no second pet (creature 900525)
expect hu minions 900525 == 0
expect hu minions 1138 == 1

log Hunter - 900525 learned: within a second a copy of the pet (creature 900525, marker 900526) joins it; the wolf stays the hunter's pet
do hu learn 900525
waitfor hu minions 900525 == 1 timeout 5s
pick sp creature:900525 near hu
require sp exists
expect sp aura 900526
expect hu pet
expect hu minions 1138 == 1
expect sp maxhealth >= 5000
expect sp maxpower focus == 100
as hu .cspet status
expect output has "Second pet"
expect output has "entry 900525"
expect output has "Bite"

log Hunter - the second pet killed: it comes back 10 sec after the hunter is out of combat (corpse 3 sec)
do gm target sp
as gm .die
waitfor hu minions 900525 == 0 timeout 5s
expect hu minions 1138 == 1
waitfor hu minions 900525 == 1 timeout 20s

log Hunter - the pet dies: the second pet goes with it; Revive Pet (982) brings both back
do gm target pt
as gm .die
waitfor hu minions 900525 == 0 timeout 3s
do hu cast 982 triggered
waitfor hu minions 1138 == 1 timeout 8s
waitfor hu minions 900525 == 1 timeout 5s

log Hunter - Dismiss Pet (2641): the second pet goes; Call Pet (883) brings both back
do hu cast 2641 triggered
waitfor hu nopet timeout 3s
waitfor hu minions 900525 == 0 timeout 3s
do hu cast 883 triggered
waitfor hu pet timeout 8s
waitfor hu minions 900525 == 1 timeout 5s

log Hunter - relog: the pet loads at login and the second pet comes back with it
do hu relog
waitfor hu exists timeout 30s
waitfor hu pet timeout 15s
waitfor hu minions 900525 == 1 timeout 10s
do hu goto -288.9 150 -423.2
wait 2s
pick sp2 creature:900525 near hu
require sp2 exists
pick pt2 creature:1138 near hu
require pt2 exists

log Hunter - .cspet attack: the second pet attacks the hunter's target d1 (passive first: it attacks on command only)
do hu target d1
as hu .cspet passive
as hu .cspet attack
waitfor sp2 victim d1 timeout 6s

log Hunter - .cspet cast Bite: the second pet bites d1 on command (autocast off as on the pet's bar; the wolf itself never fights here)
wait 3s
spelllog start
as hu .cspet cast Bite
wait 1500ms
spelllog stop
expect hu spell 52474 casts >= 1

log Hunter - .cspet autocast on Bite: it bites by itself while it fights d1
as hu .cspet autocast on Bite
as hu .cspet status
expect output has "Bite: autocast on"
spelllog start
wait 12s
spelllog stop
expect hu spell 52474 casts >= 1

log Hunter - .cspet autocast off Bite: no more bites
as hu .cspet autocast off Bite
as hu .cspet status
expect output has "Bite: autocast off"
wait 1s
spelllog start
wait 12s
spelllog stop
expect hu spell 52474 casts == 0

log Hunter - .cspet follow: the second pet stops and comes back to the hunter
as hu .cspet follow
waitfor sp2 near -288.9 150 -423.2 5 timeout 8s

log Hunter - .cspet stay: it holds its spot while the hunter steps 10 yd west
as hu .cspet stay
wait 1s
track sp2
mark stay
do hu goto -298.9 150 -423.2
wait 3s
expect sp2 at stay 2
expect hu minions 900525 == 1
as hu .cspet status
expect output has "command stay"

log Hunter - .cspet follow after the stay: back at the hunter's new spot
as hu .cspet follow
waitfor sp2 near -298.9 150 -423.2 5 timeout 8s
do hu goto -288.9 150 -423.2
wait 2s

log Hunter - react modes on command (the status line reads them back)
as hu .cspet aggressive
as hu .cspet status
expect output has "react aggressive"
as hu .cspet defensive
as hu .cspet status
expect output has "react defensive"
as hu .cspet passive
as hu .cspet status
expect output has "react passive"

log Hunter - the pet buffs reach the second pet: 900502 (+50 % damage, 901109) and 900503 (+50 % attack speed, 901110)
do hu learn 900502
do hu learn 900503
waitfor sp2 aura 901109 timeout 3s
expect sp2 aura 901110
do gm target hu
as gm .unlearn 900502
as gm .unlearn 900503
waitfor sp2 noaura 901109 timeout 3s

log Hunter - 900525 unlearned: the second pet goes, the wolf stays
as gm .unlearn 900525
waitfor hu minions 900525 == 0 timeout 3s
expect hu pet
expect hu minions 1138 == 1

# ---------------------------------------------------------------- Warlock
log Warlock - control: without 900858 a second summon replaces the demon, nothing stays
do wl cast 688 triggered
waitfor wl minions 416 == 1 timeout 5s
do wl cast 697 triggered
waitfor wl minions 1860 == 1 timeout 5s
wait 1s
expect wl minions 416 == 0

log Warlock - 900858: the demon that was out (the Voidwalker) stays as the second demon when the Imp is summoned
do wl learn 900858
wait 1s
expect wl minions 416 == 0
do wl cast 688 triggered
waitfor wl minions 416 == 1 timeout 5s
# the swap: the old Voidwalker pet stays in the world (and counts as a minion)
# until the end of the next map update, the copy follows at the next
# half-second check (run 480 picked the leaving pet) - pick once it is over
wait 1500ms
expect wl minions 1860 == 1
pick sv creature:1860 near wl
require sv exists
waitfor sv aura 900526 timeout 3s
pick pi creature:416 near wl
expect pi noaura 900526
expect wl pet
as wl .cspet status
expect output has "entry 1860"

log Warlock - two demons at most: the Succubus (712) replaces the second demon with the demon that was out, the Imp
do wl cast 712 triggered
waitfor wl minions 1863 == 1 timeout 5s
wait 1500ms
expect wl minions 1860 == 0
expect wl minions 416 == 1
pick si creature:416 near wl
require si exists
waitfor si aura 900526 timeout 3s

log Warlock - summoning the demon that is out again changes nothing
do wl cast 712 triggered
wait 2s
expect wl minions 1863 == 1
expect wl minions 416 == 1
expect wl minions 1860 == 0

log Warlock - the second Imp on command: it attacks d1 and casts Firebolt (47964) at it, then casts it by itself with autocast on
do wl target d1
as wl .cspet attack
waitfor si victim d1 timeout 6s
spelllog start
as wl .cspet cast Firebolt
wait 4s
spelllog stop
expect wl spell 47964 casts >= 1
as wl .cspet autocast on Firebolt
as wl .cspet status
expect output has "Firebolt: autocast on"
spelllog start
wait 8s
spelllog stop
expect wl spell 47964 casts >= 2
as wl .cspet autocast off Firebolt
as wl .cspet follow

log Warlock - Imp +50 % damage (900836, a minion aura by entry) reaches the second Imp too
do wl learn 900836
waitfor si aura 901109 timeout 3s
do gm target wl
as gm .unlearn 900836
waitfor si noaura 901109 timeout 3s

log Warlock - Dismiss Pet (2641): the second demon goes with the demon
do wl cast 2641 triggered
waitfor wl minions 416 == 0 timeout 3s
expect wl nopet
expect wl minions 1863 == 0

log Warlock - after a dismiss a summon starts over: no second demon
do wl cast 688 triggered
waitfor wl minions 416 == 1 timeout 5s
wait 1s
expect wl minions 1863 == 0
pick pi2 creature:416 near wl
expect pi2 noaura 900526

log Warlock - 900858 unlearned: the second demon goes, the demon stays
do wl cast 697 triggered
waitfor wl minions 1860 == 1 timeout 5s
wait 1500ms
pick si3 creature:416 near wl
require si3 exists
waitfor si3 aura 900526 timeout 3s
as gm .unlearn 900858
waitfor wl minions 416 == 0 timeout 3s
expect wl minions 1860 == 1

cleanup
do hu stop
do wl stop
do gm target hu
as gm .unlearn 900525
as gm .unlearn 900502
as gm .unlearn 900503
do gm target wl
as gm .unlearn 900858
as gm .unlearn 900836
do wl cast 2641 triggered
do hu cast 2641 triggered
wait 1s
do hu cast 883 triggered
waitfor hu pet timeout 8s
